# Server Configuration
PORT=3000

# Webhook Verification Token
# Set this to any random secret string you choose (e.g. my_super_secret_verify_token_123).
# You will enter this exact same string in the Meta App Dashboard when setting up the webhook.
VERIFY_TOKEN=my_super_secret_verify_token_123

# Meta Graph API Page Access Token
# Obtained from Meta for Developers -> Tools -> Graph API Explorer (or your Meta App System User).
# Leave blank to run in DRY_RUN simulation mode.
PAGE_ACCESS_TOKEN=

# Your Instagram Account ID
# Used to prevent the bot from replying to your own comments or getting into loops.
INSTAGRAM_ACCOUNT_ID=

# Keywords to listen for in comments (comma-separated, case-insensitive)
TRIGGER_KEYWORDS=link,guide,pdf,send,book

# The Direct Message text sent to the user
DM_REPLY_TEXT=Hey there! 🎉 Thanks for your comment. Here is the link you requested:\n\n👉 https://example.com/your-free-resource\n\nEnjoy!

# Public reply to the comment (leave empty to disable public replies)
PUBLIC_COMMENT_REPLY=Sent to your DMs! Check your inbox 📥✨

# Delay between outgoing messages in milliseconds (prevents Meta rate-limits)
MESSAGE_DELAY_MS=1500

# Set to true to simulate actions without calling Meta's real API
DRY_RUN=true
